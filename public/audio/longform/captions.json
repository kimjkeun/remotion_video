{
  "c00-01": [
    {
      "text": "무더운 여름날,",
      "startMs": 0,
      "endMs": 1710
    },
    {
      "text": "에어컨을 켜면 금세",
      "startMs": 1710,
      "endMs": 3500
    },
    {
      "text": "시원한 바람이 나오죠.",
      "startMs": 3500,
      "endMs": 4980
    }
  ],
  "c00-02": [
    {
      "text": "그런데 에어컨은 도대체 어떻게",
      "startMs": 0,
      "endMs": 2110
    },
    {
      "text": "차가운 바람을 만들어 낼까요?",
      "startMs": 2110,
      "endMs": 5220
    }
  ],
  "c00-03": [
    {
      "text": "얼음을 넣어 두는 것도 아니고,",
      "startMs": 0,
      "endMs": 2490
    },
    {
      "text": "차가운 공기를 어디서 가져오는",
      "startMs": 2490,
      "endMs": 4580
    },
    {
      "text": "것도 아닌데 말이에요.",
      "startMs": 4580,
      "endMs": 5880
    }
  ],
  "c00-04": [
    {
      "text": "놀랍게도 에어컨은",
      "startMs": 0,
      "endMs": 1980
    },
    {
      "text": "냉기를 만들지 않아요.",
      "startMs": 1980,
      "endMs": 4060
    }
  ],
  "c00-05": [
    {
      "text": "에어컨이 하는 일은,",
      "startMs": 0,
      "endMs": 1590
    },
    {
      "text": "방 안의 열을 바깥으로",
      "startMs": 1590,
      "endMs": 2970
    },
    {
      "text": "옮기는 거예요.",
      "startMs": 2970,
      "endMs": 4280
    }
  ],
  "c00-06": [
    {
      "text": "오늘은 그 원리를 하나씩,",
      "startMs": 0,
      "endMs": 1850
    },
    {
      "text": "천천히 알아보겠습니다.",
      "startMs": 1850,
      "endMs": 3740
    }
  ],
  "c01-01": [
    {
      "text": "먼저 꼭 알아야 할",
      "startMs": 0,
      "endMs": 1750
    },
    {
      "text": "규칙이 하나 있어요.",
      "startMs": 1750,
      "endMs": 2980
    }
  ],
  "c01-02": [
    {
      "text": "열은 언제나 뜨거운 곳에서",
      "startMs": 0,
      "endMs": 1730
    },
    {
      "text": "차가운 곳으로만 흘러요.",
      "startMs": 1730,
      "endMs": 4120
    }
  ],
  "c01-03": [
    {
      "text": "뜨거운 코코아를 그냥",
      "startMs": 0,
      "endMs": 1540
    },
    {
      "text": "두면 점점 식고,",
      "startMs": 1540,
      "endMs": 3660
    },
    {
      "text": "얼음은 점점 녹죠.",
      "startMs": 3660,
      "endMs": 5240
    }
  ],
  "c01-04": [
    {
      "text": "코코아의 열은 주변 공기로,",
      "startMs": 0,
      "endMs": 2070
    },
    {
      "text": "주변 공기의 열은 얼음으로",
      "startMs": 2070,
      "endMs": 4190
    },
    {
      "text": "옮겨 가기 때문이에요.",
      "startMs": 4190,
      "endMs": 6040
    }
  ],
  "c01-05": [
    {
      "text": "반대로, 열이 저절로 차가운 곳에서 뜨거운",
      "startMs": 0,
      "endMs": 3440
    },
    {
      "text": "곳으로 흐르는 일은 없어요.",
      "startMs": 3440,
      "endMs": 5040
    }
  ],
  "c02-01": [
    {
      "text": "그런데 여름을 떠올려 보세요.",
      "startMs": 0,
      "endMs": 2180
    }
  ],
  "c02-02": [
    {
      "text": "방 안이 30도라면,",
      "startMs": 0,
      "endMs": 2000
    },
    {
      "text": "바깥은 35도가 넘을 때도 많아요.",
      "startMs": 2000,
      "endMs": 4840
    }
  ],
  "c02-03": [
    {
      "text": "열은 뜨거운 곳에서 차가운",
      "startMs": 0,
      "endMs": 1640
    },
    {
      "text": "곳으로만 흐른다고 했죠?",
      "startMs": 1640,
      "endMs": 3880
    }
  ],
  "c02-04": [
    {
      "text": "그럼 방 안의 열을,",
      "startMs": 0,
      "endMs": 1820
    },
    {
      "text": "더 뜨거운 바깥으로 어떻게",
      "startMs": 1820,
      "endMs": 4000
    },
    {
      "text": "내보낼 수 있을까요?",
      "startMs": 4000,
      "endMs": 5760
    }
  ],
  "c02-05": [
    {
      "text": "물에 비유해 볼게요.",
      "startMs": 0,
      "endMs": 1260
    },
    {
      "text": "물은 원래 높은 곳에서",
      "startMs": 1260,
      "endMs": 3420
    },
    {
      "text": "낮은 곳으로만 흘러요.",
      "startMs": 3420,
      "endMs": 6020
    }
  ],
  "c02-06": [
    {
      "text": "하지만 펌프를 쓰면 물을 낮은 곳에서",
      "startMs": 0,
      "endMs": 3300
    },
    {
      "text": "높은 곳으로 퍼 올릴 수 있죠.",
      "startMs": 3300,
      "endMs": 5480
    }
  ],
  "c02-07": [
    {
      "text": "에어컨은 바로 열을 퍼 올리는 펌프,",
      "startMs": 0,
      "endMs": 3380
    },
    {
      "text": "즉 열 펌프예요.",
      "startMs": 3380,
      "endMs": 5760
    }
  ],
  "c02-08": [
    {
      "text": "그리고 이 일을 해내는",
      "startMs": 0,
      "endMs": 1620
    },
    {
      "text": "주인공이 바로 냉매입니다.",
      "startMs": 1620,
      "endMs": 4180
    }
  ],
  "c03-01": [
    {
      "text": "냉매를 이해하려면 손소독제를",
      "startMs": 0,
      "endMs": 2230
    },
    {
      "text": "떠올려 보면 좋아요.",
      "startMs": 2230,
      "endMs": 3840
    }
  ],
  "c03-02": [
    {
      "text": "손소독제를 바르면 손이 시원해지죠.",
      "startMs": 0,
      "endMs": 2960
    }
  ],
  "c03-03": [
    {
      "text": "알코올이 액체에서 기체로 날아가면서,",
      "startMs": 0,
      "endMs": 4400
    },
    {
      "text": "손의 열을 빼앗아 가기 때문이에요.",
      "startMs": 4400,
      "endMs": 6420
    }
  ],
  "c03-04": [
    {
      "text": "이렇게 액체가 기체로 변하는",
      "startMs": 0,
      "endMs": 2770
    },
    {
      "text": "걸 증발이라고 하는데,",
      "startMs": 2770,
      "endMs": 4580
    },
    {
      "text": "증발할 때는 주변의 열을 빼앗아요.",
      "startMs": 4580,
      "endMs": 7660
    }
  ],
  "c03-05": [
    {
      "text": "여름에 땀이 마를 때",
      "startMs": 0,
      "endMs": 1680
    },
    {
      "text": "시원한 것도 같은 원리예요.",
      "startMs": 1680,
      "endMs": 3580
    }
  ],
  "c03-06": [
    {
      "text": "반대로 기체가 다시",
      "startMs": 0,
      "endMs": 1800
    },
    {
      "text": "액체로 변할 때는,",
      "startMs": 1800,
      "endMs": 4170
    },
    {
      "text": "품고 있던 열을 내놓아요.",
      "startMs": 4170,
      "endMs": 5840
    }
  ],
  "c03-07": [
    {
      "text": "열을 빼앗고,",
      "startMs": 0,
      "endMs": 1840
    },
    {
      "text": "내놓고. 에어컨은 이 두 가지를",
      "startMs": 1840,
      "endMs": 5030
    },
    {
      "text": "번갈아 이용해요.",
      "startMs": 5030,
      "endMs": 6340
    }
  ],
  "c04-01": [
    {
      "text": "그런데 물은 100도가",
      "startMs": 0,
      "endMs": 2460
    },
    {
      "text": "되어야 끓잖아요.",
      "startMs": 2460,
      "endMs": 3660
    }
  ],
  "c04-02": [
    {
      "text": "방 안의 30도 공기로는",
      "startMs": 0,
      "endMs": 1820
    },
    {
      "text": "물을 끓게 할 수 없어요.",
      "startMs": 1820,
      "endMs": 4120
    }
  ],
  "c04-03": [
    {
      "text": "그래서 에어컨에는 아주 낮은",
      "startMs": 0,
      "endMs": 2460
    },
    {
      "text": "온도에서도 끓는 특별한 물질,",
      "startMs": 2460,
      "endMs": 4930
    },
    {
      "text": "냉매가 들어 있어요.",
      "startMs": 4930,
      "endMs": 7020
    }
  ],
  "c04-04": [
    {
      "text": "에어컨에 많이 쓰이는 냉매는 보통의",
      "startMs": 0,
      "endMs": 2790
    },
    {
      "text": "압력에서 영하 50도쯤이면 끓어요.",
      "startMs": 2790,
      "endMs": 5940
    }
  ],
  "c04-05": [
    {
      "text": "또 하나 중요한 성질이 있어요.",
      "startMs": 0,
      "endMs": 1600
    },
    {
      "text": "압력이 높으면 잘 끓지 않고,",
      "startMs": 1600,
      "endMs": 4780
    },
    {
      "text": "압력이 낮으면 쉽게 끓어요.",
      "startMs": 4780,
      "endMs": 7380
    }
  ],
  "c04-06": [
    {
      "text": "압력솥이 그 예예요.",
      "startMs": 0,
      "endMs": 2670
    },
    {
      "text": "압력을 높이면 물이 100도가",
      "startMs": 2670,
      "endMs": 5230
    },
    {
      "text": "넘어도 끓지 않아요.",
      "startMs": 5230,
      "endMs": 6200
    }
  ],
  "c04-07": [
    {
      "text": "에어컨은 이 압력을 조절해서,",
      "startMs": 0,
      "endMs": 2280
    },
    {
      "text": "냉매가 끓을 곳과 다시",
      "startMs": 2280,
      "endMs": 5040
    },
    {
      "text": "액체가 될 곳을 정해요.",
      "startMs": 5040,
      "endMs": 6520
    }
  ],
  "c05-01": [
    {
      "text": "이제 에어컨 속을 들여다볼게요.",
      "startMs": 0,
      "endMs": 2800
    }
  ],
  "c05-02": [
    {
      "text": "에어컨은 방 안의",
      "startMs": 0,
      "endMs": 1520
    },
    {
      "text": "실내기와 바깥의 실외기,",
      "startMs": 1520,
      "endMs": 4040
    },
    {
      "text": "그리고 둘을 잇는 구리",
      "startMs": 4040,
      "endMs": 5410
    },
    {
      "text": "배관으로 되어 있어요.",
      "startMs": 5410,
      "endMs": 6900
    }
  ],
  "c05-03": [
    {
      "text": "냉매는 이 배관을 따라",
      "startMs": 0,
      "endMs": 1350
    },
    {
      "text": "쉬지 않고 빙글빙글 돌아요.",
      "startMs": 1350,
      "endMs": 3940
    }
  ],
  "c05-04": [
    {
      "text": "중요한 부품은 네 가지예요.",
      "startMs": 0,
      "endMs": 1260
    },
    {
      "text": "실내기, 압축기,",
      "startMs": 1260,
      "endMs": 3110
    },
    {
      "text": "실외기, 그리고 팽창밸브.",
      "startMs": 3110,
      "endMs": 7420
    }
  ],
  "c05-05": [
    {
      "text": "첫 번째, 실내기예요.",
      "startMs": 0,
      "endMs": 1860
    }
  ],
  "c05-06": [
    {
      "text": "실내기 속 냉매는 약 5도로,",
      "startMs": 0,
      "endMs": 3000
    },
    {
      "text": "방 공기보다 훨씬 차가워요.",
      "startMs": 3000,
      "endMs": 5160
    }
  ],
  "c05-07": [
    {
      "text": "팬이 방의 따뜻한 공기를 빨아들여",
      "startMs": 0,
      "endMs": 3610
    },
    {
      "text": "차가운 배관 사이로 지나가게 해요.",
      "startMs": 3610,
      "endMs": 5800
    }
  ],
  "c05-08": [
    {
      "text": "공기의 열은 차가운",
      "startMs": 0,
      "endMs": 1290
    },
    {
      "text": "냉매로 옮겨 가고,",
      "startMs": 1290,
      "endMs": 3430
    },
    {
      "text": "열을 받은 냉매는",
      "startMs": 3430,
      "endMs": 5000
    },
    {
      "text": "끓어서 기체가 돼요.",
      "startMs": 5000,
      "endMs": 6400
    }
  ],
  "c05-09": [
    {
      "text": "열을 빼앗긴 공기는 차가워져서",
      "startMs": 0,
      "endMs": 2270
    },
    {
      "text": "다시 방으로 나와요.",
      "startMs": 2270,
      "endMs": 4020
    },
    {
      "text": "이게 바로 에어컨 바람이에요.",
      "startMs": 4020,
      "endMs": 6120
    }
  ],
  "c05-10": [
    {
      "text": "두 번째, 압축기예요.",
      "startMs": 0,
      "endMs": 2060
    }
  ],
  "c05-11": [
    {
      "text": "기체가 된 냉매는 아직",
      "startMs": 0,
      "endMs": 1960
    },
    {
      "text": "바깥보다 차가워서,",
      "startMs": 1960,
      "endMs": 3470
    },
    {
      "text": "이대로는 열을 버릴 수가 없어요.",
      "startMs": 3470,
      "endMs": 6420
    }
  ],
  "c05-12": [
    {
      "text": "그래서 압축기가 냉매 기체를",
      "startMs": 0,
      "endMs": 3910
    },
    {
      "text": "꾹 눌러서 압력을 높여요.",
      "startMs": 3910,
      "endMs": 5340
    }
  ],
  "c05-13": [
    {
      "text": "자전거 펌프로 바람을 넣으면",
      "startMs": 0,
      "endMs": 2590
    },
    {
      "text": "펌프가 뜨거워지는 것처럼,",
      "startMs": 2590,
      "endMs": 3800
    },
    {
      "text": "눌린 기체는 뜨거워져요.",
      "startMs": 3800,
      "endMs": 6420
    }
  ],
  "c05-14": [
    {
      "text": "냉매의 온도는 70도",
      "startMs": 0,
      "endMs": 1980
    },
    {
      "text": "가까이 올라가요.",
      "startMs": 1980,
      "endMs": 3440
    },
    {
      "text": "이제 바깥보다 훨씬 뜨겁죠.",
      "startMs": 3440,
      "endMs": 5660
    }
  ],
  "c05-15": [
    {
      "text": "세 번째, 실외기예요.",
      "startMs": 0,
      "endMs": 2060
    }
  ],
  "c05-16": [
    {
      "text": "뜨거운 냉매가 실외기",
      "startMs": 0,
      "endMs": 1820
    },
    {
      "text": "배관을 지나는 동안,",
      "startMs": 1820,
      "endMs": 2730
    },
    {
      "text": "팬이 바깥 공기를 불어 줘요.",
      "startMs": 2730,
      "endMs": 5360
    }
  ],
  "c05-17": [
    {
      "text": "냉매가 바깥 공기보다 뜨거우니,",
      "startMs": 0,
      "endMs": 2690
    },
    {
      "text": "이번에는 열이 냉매에서",
      "startMs": 2690,
      "endMs": 4260
    },
    {
      "text": "바깥으로 빠져나가요.",
      "startMs": 4260,
      "endMs": 6020
    }
  ],
  "c05-18": [
    {
      "text": "열을 내놓은 냉매는",
      "startMs": 0,
      "endMs": 1180
    },
    {
      "text": "다시 액체로 돌아와요.",
      "startMs": 1180,
      "endMs": 2900
    }
  ],
  "c05-19": [
    {
      "text": "실외기 앞에 서면 뜨거운 바람이",
      "startMs": 0,
      "endMs": 2110
    },
    {
      "text": "나오는 이유가 바로 이거예요.",
      "startMs": 2110,
      "endMs": 4390
    },
    {
      "text": "방에서 가져온 열이거든요.",
      "startMs": 4390,
      "endMs": 6160
    }
  ],
  "c05-20": [
    {
      "text": "네 번째, 팽창밸브예요.",
      "startMs": 0,
      "endMs": 2120
    }
  ],
  "c05-21": [
    {
      "text": "액체 냉매는 아주 좁은 구멍을",
      "startMs": 0,
      "endMs": 2710
    },
    {
      "text": "지나면서 압력이 확 낮아져요.",
      "startMs": 2710,
      "endMs": 5580
    }
  ],
  "c05-22": [
    {
      "text": "압력이 낮아지면 냉매의",
      "startMs": 0,
      "endMs": 2270
    },
    {
      "text": "온도도 뚝 떨어져요.",
      "startMs": 2270,
      "endMs": 4140
    }
  ],
  "c05-23": [
    {
      "text": "스프레이를 오래 뿌리면 캔이",
      "startMs": 0,
      "endMs": 3410
    },
    {
      "text": "차가워지는 것과 비슷한 원리예요.",
      "startMs": 3410,
      "endMs": 5360
    }
  ],
  "c05-24": [
    {
      "text": "다시 차가워진 냉매는",
      "startMs": 0,
      "endMs": 1890
    },
    {
      "text": "실내기로 돌아가서,",
      "startMs": 1890,
      "endMs": 3600
    },
    {
      "text": "처음부터 같은 일을 반복해요.",
      "startMs": 3600,
      "endMs": 6120
    }
  ],
  "c06-01": [
    {
      "text": "정리해 볼게요.",
      "startMs": 0,
      "endMs": 1140
    }
  ],
  "c06-02": [
    {
      "text": "실내기에서 냉매가 끓으며",
      "startMs": 0,
      "endMs": 2250
    },
    {
      "text": "방의 열을 빼앗고,",
      "startMs": 2250,
      "endMs": 3440
    }
  ],
  "c06-03": [
    {
      "text": "압축기가 냉매를 뜨겁게 만들고,",
      "startMs": 0,
      "endMs": 2600
    }
  ],
  "c06-04": [
    {
      "text": "실외기에서 그 열을 바깥에 버리고,",
      "startMs": 0,
      "endMs": 2240
    }
  ],
  "c06-05": [
    {
      "text": "팽창밸브에서 다시 차갑게 만들어요.",
      "startMs": 0,
      "endMs": 2820
    }
  ],
  "c06-06": [
    {
      "text": "이 순환을 계속 반복하면서,",
      "startMs": 0,
      "endMs": 1750
    },
    {
      "text": "방의 열을 바깥으로",
      "startMs": 1750,
      "endMs": 3580
    },
    {
      "text": "퍼 나르는 거예요.",
      "startMs": 3580,
      "endMs": 5020
    }
  ],
  "c07-01": [
    {
      "text": "에어컨에서 물이 떨어지는",
      "startMs": 0,
      "endMs": 1990
    },
    {
      "text": "걸 본 적 있나요?",
      "startMs": 1990,
      "endMs": 3120
    }
  ],
  "c07-02": [
    {
      "text": "얼음물을 담은 컵 바깥에 물방울이",
      "startMs": 0,
      "endMs": 3410
    },
    {
      "text": "맺히는 것과 같은 현상이에요.",
      "startMs": 3410,
      "endMs": 5760
    }
  ],
  "c07-03": [
    {
      "text": "공기 속에는 눈에 보이지",
      "startMs": 0,
      "endMs": 1720
    },
    {
      "text": "않는 수증기가 섞여 있어요.",
      "startMs": 1720,
      "endMs": 3880
    }
  ],
  "c07-04": [
    {
      "text": "이 수증기가 차가운 실내기",
      "startMs": 0,
      "endMs": 1470
    },
    {
      "text": "배관에 닿으면 물방울로 바뀌어요.",
      "startMs": 1470,
      "endMs": 4920
    }
  ],
  "c07-05": [
    {
      "text": "그래서 에어컨을 켜면 방이",
      "startMs": 0,
      "endMs": 2130
    },
    {
      "text": "시원해질 뿐만 아니라,",
      "startMs": 2130,
      "endMs": 3310
    },
    {
      "text": "습기도 줄어들어 뽀송해져요.",
      "startMs": 3310,
      "endMs": 6180
    }
  ],
  "c07-06": [
    {
      "text": "모인 물은 배수 호스를",
      "startMs": 0,
      "endMs": 1110
    },
    {
      "text": "따라 바깥으로 빠져나가요.",
      "startMs": 1110,
      "endMs": 3640
    }
  ],
  "c08-01": [
    {
      "text": "이 원리는 에어컨에만 쓰이지 않아요.",
      "startMs": 0,
      "endMs": 3260
    }
  ],
  "c08-02": [
    {
      "text": "냉장고도 똑같아요.",
      "startMs": 0,
      "endMs": 1470
    },
    {
      "text": "냉장고 안의 열을",
      "startMs": 1470,
      "endMs": 3280
    },
    {
      "text": "빼내서 바깥으로 버리죠.",
      "startMs": 3280,
      "endMs": 5480
    }
  ],
  "c08-03": [
    {
      "text": "냉장고 뒤쪽이나 옆면이 따뜻한 건,",
      "startMs": 0,
      "endMs": 3400
    },
    {
      "text": "안에서 빼낸 열이 나오기 때문이에요.",
      "startMs": 3400,
      "endMs": 5940
    }
  ],
  "c08-04": [
    {
      "text": "냉난방기는 냉매가 흐르는",
      "startMs": 0,
      "endMs": 2760
    },
    {
      "text": "방향을 거꾸로 바꿔서,",
      "startMs": 2760,
      "endMs": 4940
    },
    {
      "text": "겨울에는 바깥의 열을",
      "startMs": 4940,
      "endMs": 6410
    },
    {
      "text": "방 안으로 가져와요.",
      "startMs": 6410,
      "endMs": 7540
    }
  ],
  "c08-05": [
    {
      "text": "추운 겨울 공기에도",
      "startMs": 0,
      "endMs": 1280
    },
    {
      "text": "열은 남아 있어서,",
      "startMs": 1280,
      "endMs": 2580
    },
    {
      "text": "그 열을 퍼 올려",
      "startMs": 2580,
      "endMs": 4060
    },
    {
      "text": "난방을 하는 거예요.",
      "startMs": 4060,
      "endMs": 5940
    }
  ],
  "c09-01": [
    {
      "text": "마지막으로,",
      "startMs": 0,
      "endMs": 780
    },
    {
      "text": "원리를 알면 에어컨을 더",
      "startMs": 780,
      "endMs": 3570
    },
    {
      "text": "똑똑하게 쓸 수 있어요.",
      "startMs": 3570,
      "endMs": 5260
    }
  ],
  "c09-02": [
    {
      "text": "첫째, 희망 온도는 26도 정도가 적당해요.",
      "startMs": 0,
      "endMs": 3670
    },
    {
      "text": "바깥과 온도 차이가 클수록 퍼",
      "startMs": 3670,
      "endMs": 7180
    },
    {
      "text": "날라야 할 열이 많아지거든요.",
      "startMs": 7180,
      "endMs": 8980
    }
  ],
  "c09-03": [
    {
      "text": "둘째, 필터를 깨끗하게 청소해 주세요.",
      "startMs": 0,
      "endMs": 3830
    },
    {
      "text": "먼지가 쌓이면 공기가 잘",
      "startMs": 3830,
      "endMs": 5810
    },
    {
      "text": "지나가지 못해 열을 덜 빼앗아요.",
      "startMs": 5810,
      "endMs": 8660
    }
  ],
  "c09-04": [
    {
      "text": "셋째, 실외기 주변을 막지 마세요.",
      "startMs": 0,
      "endMs": 2860
    },
    {
      "text": "열을 버리는 곳이 막히면",
      "startMs": 2860,
      "endMs": 4660
    },
    {
      "text": "에어컨이 훨씬 힘들어져요.",
      "startMs": 4660,
      "endMs": 7220
    }
  ],
  "c09-05": [
    {
      "text": "실외기에 햇빛 가리개를 해 주면",
      "startMs": 0,
      "endMs": 2470
    },
    {
      "text": "열을 더 잘 버릴 수 있어요.",
      "startMs": 2470,
      "endMs": 4280
    }
  ],
  "c09-06": [
    {
      "text": "이렇게만 해도 전기 요금을 아끼면서",
      "startMs": 0,
      "endMs": 2900
    },
    {
      "text": "더 시원하게 지낼 수 있어요.",
      "startMs": 2900,
      "endMs": 4920
    }
  ],
  "c10-01": [
    {
      "text": "오늘 내용을 한 문장으로 정리하면,",
      "startMs": 0,
      "endMs": 2520
    },
    {
      "text": "에어컨은 냉기를 만드는 기계가",
      "startMs": 2520,
      "endMs": 5500
    },
    {
      "text": "아니라 열을 옮기는 기계예요.",
      "startMs": 5500,
      "endMs": 7840
    }
  ],
  "c10-02": [
    {
      "text": "다음에 에어컨 바람을 쐴 때,",
      "startMs": 0,
      "endMs": 2470
    },
    {
      "text": "바깥 실외기에서 열심히 열을",
      "startMs": 2470,
      "endMs": 4460
    },
    {
      "text": "버리고 있는 모습을 떠올려 보세요.",
      "startMs": 4460,
      "endMs": 6600
    }
  ],
  "c10-03": [
    {
      "text": "영상이 도움이 되었다면",
      "startMs": 0,
      "endMs": 2240
    },
    {
      "text": "구독과 좋아요 부탁드려요.",
      "startMs": 2240,
      "endMs": 4600
    },
    {
      "text": "다음 영상에서 만나요!",
      "startMs": 4600,
      "endMs": 6200
    }
  ]
}
