{
  "s1-01": [
    {
      "text": "에어컨 바람은 왜 차가울까요?",
      "startMs": 0,
      "endMs": 2540
    }
  ],
  "s1-02": [
    {
      "text": "사실 에어컨은 냉기를 만들지 않아요.",
      "startMs": 0,
      "endMs": 3760
    }
  ],
  "s1-03": [
    {
      "text": "방 안의 열을 바깥으로",
      "startMs": 0,
      "endMs": 1570
    },
    {
      "text": "옮기는 기계예요.",
      "startMs": 1570,
      "endMs": 3500
    }
  ],
  "s2-01": [
    {
      "text": "그런데 열은 뜨거운 곳에서",
      "startMs": 0,
      "endMs": 3030
    },
    {
      "text": "차가운 곳으로만 흘러요.",
      "startMs": 3030,
      "endMs": 4780
    }
  ],
  "s2-02": [
    {
      "text": "여름엔 바깥이 더 뜨거운데,",
      "startMs": 0,
      "endMs": 3220
    },
    {
      "text": "어떻게 열을 내보낼까요?",
      "startMs": 3220,
      "endMs": 4880
    }
  ],
  "s2-03": [
    {
      "text": "비밀은 바로 냉매예요.",
      "startMs": 0,
      "endMs": 1840
    }
  ],
  "s3-01": [
    {
      "text": "실내기에서는 5도의 차가운",
      "startMs": 0,
      "endMs": 2320
    },
    {
      "text": "냉매가 방의 열을 흡수해요.",
      "startMs": 2320,
      "endMs": 5020
    }
  ],
  "s3-02": [
    {
      "text": "압축기가 냉매를 꾹 눌러서",
      "startMs": 0,
      "endMs": 3360
    },
    {
      "text": "70도로 뜨겁게 만들고,",
      "startMs": 3360,
      "endMs": 4620
    }
  ],
  "s3-03": [
    {
      "text": "실외기에서 그 열을 바깥에 버려요.",
      "startMs": 0,
      "endMs": 2740
    }
  ],
  "s3-04": [
    {
      "text": "팽창밸브를 지나면 냉매는",
      "startMs": 0,
      "endMs": 2570
    },
    {
      "text": "다시 차갑게 식어요.",
      "startMs": 2570,
      "endMs": 3840
    }
  ],
  "s4-01": [
    {
      "text": "이 순환을 쉬지 않고 반복하는 것,",
      "startMs": 0,
      "endMs": 2690
    },
    {
      "text": "그게 에어컨의 원리예요.",
      "startMs": 2690,
      "endMs": 4800
    }
  ],
  "s4-02": [
    {
      "text": "더 자세한 이야기는 롱폼",
      "startMs": 0,
      "endMs": 1580
    },
    {
      "text": "영상에서 확인해 보세요!",
      "startMs": 1580,
      "endMs": 3420
    }
  ]
}
