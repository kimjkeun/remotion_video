{
  "k00-01": [
    {
      "text": "맑은 날 고개를 들면",
      "startMs": 0,
      "endMs": 1610
    },
    {
      "text": "하늘은 새파랗죠.",
      "startMs": 1610,
      "endMs": 3340
    }
  ],
  "k00-02": [
    {
      "text": "그런데 해 질 무렵이 되면,",
      "startMs": 0,
      "endMs": 1370
    },
    {
      "text": "같은 하늘이 주황빛과",
      "startMs": 1370,
      "endMs": 3250
    },
    {
      "text": "붉은빛으로 물들어요.",
      "startMs": 3250,
      "endMs": 5660
    }
  ],
  "k00-03": [
    {
      "text": "하늘에 파란 물감을",
      "startMs": 0,
      "endMs": 1620
    },
    {
      "text": "칠한 것도 아닌데,",
      "startMs": 1620,
      "endMs": 3030
    },
    {
      "text": "왜 이런 일이 생길까요?",
      "startMs": 3030,
      "endMs": 4100
    }
  ],
  "k00-04": [
    {
      "text": "답은 햇빛과 공기가 만나는",
      "startMs": 0,
      "endMs": 1980
    },
    {
      "text": "순간에 숨어 있어요.",
      "startMs": 1980,
      "endMs": 3540
    }
  ],
  "k00-05": [
    {
      "text": "오늘은 하늘의 색이 만들어지는",
      "startMs": 0,
      "endMs": 1830
    },
    {
      "text": "원리를 천천히 알아보겠습니다.",
      "startMs": 1830,
      "endMs": 4260
    }
  ],
  "k01-01": [
    {
      "text": "먼저 햇빛부터 살펴볼게요.",
      "startMs": 0,
      "endMs": 2760
    }
  ],
  "k01-02": [
    {
      "text": "햇빛은 하얗게 보이지만,",
      "startMs": 0,
      "endMs": 2770
    },
    {
      "text": "사실 여러 가지 색의",
      "startMs": 2770,
      "endMs": 4190
    },
    {
      "text": "빛이 섞여 있어요.",
      "startMs": 4190,
      "endMs": 5420
    }
  ],
  "k01-03": [
    {
      "text": "프리즘에 햇빛을 통과시키면",
      "startMs": 0,
      "endMs": 2480
    },
    {
      "text": "빨주노초파남보 무지개",
      "startMs": 2480,
      "endMs": 4360
    },
    {
      "text": "색으로 갈라지죠.",
      "startMs": 4360,
      "endMs": 5500
    }
  ],
  "k01-04": [
    {
      "text": "빛은 물결처럼 움직이는데,",
      "startMs": 0,
      "endMs": 2910
    },
    {
      "text": "물결 사이의 간격을 파장이라고 해요.",
      "startMs": 2910,
      "endMs": 5880
    }
  ],
  "k01-05": [
    {
      "text": "빨간빛은 파장이 길고,",
      "startMs": 0,
      "endMs": 2020
    },
    {
      "text": "파란빛과 보랏빛은 파장이 짧아요.",
      "startMs": 2020,
      "endMs": 5240
    }
  ],
  "k01-06": [
    {
      "text": "이 파장의 차이가 하늘의",
      "startMs": 0,
      "endMs": 1910
    },
    {
      "text": "색을 정하는 열쇠예요.",
      "startMs": 1910,
      "endMs": 4080
    }
  ],
  "k02-01": [
    {
      "text": "햇빛은 지구에 도착하기 전에",
      "startMs": 0,
      "endMs": 2760
    },
    {
      "text": "두꺼운 공기층을 지나와야 해요.",
      "startMs": 2760,
      "endMs": 5320
    }
  ],
  "k02-02": [
    {
      "text": "공기는 질소와 산소 같은 아주",
      "startMs": 0,
      "endMs": 2140
    },
    {
      "text": "작은 분자들로 이루어져 있어요.",
      "startMs": 2140,
      "endMs": 5500
    }
  ],
  "k02-03": [
    {
      "text": "빛이 이 작은 분자들을 만나면,",
      "startMs": 0,
      "endMs": 2040
    },
    {
      "text": "일부가 사방으로 튕겨 흩어져요.",
      "startMs": 2040,
      "endMs": 5120
    }
  ],
  "k02-04": [
    {
      "text": "이렇게 빛이 여러 방향으로",
      "startMs": 0,
      "endMs": 1740
    },
    {
      "text": "흩어지는 것을 산란이라고 해요.",
      "startMs": 1740,
      "endMs": 4500
    }
  ],
  "k03-01": [
    {
      "text": "그런데 모든 색이 똑같이",
      "startMs": 0,
      "endMs": 1890
    },
    {
      "text": "흩어지지는 않아요.",
      "startMs": 1890,
      "endMs": 3640
    }
  ],
  "k03-02": [
    {
      "text": "공기 분자처럼 아주",
      "startMs": 0,
      "endMs": 1680
    },
    {
      "text": "작은 알갱이에서는,",
      "startMs": 1680,
      "endMs": 3280
    },
    {
      "text": "파장이 짧은 빛일수록",
      "startMs": 3280,
      "endMs": 4910
    },
    {
      "text": "훨씬 잘 흩어져요.",
      "startMs": 4910,
      "endMs": 6520
    }
  ],
  "k03-03": [
    {
      "text": "파장이 절반으로 짧아지면,",
      "startMs": 0,
      "endMs": 2000
    },
    {
      "text": "흩어지는 정도는 무려 16배가 돼요.",
      "startMs": 2000,
      "endMs": 5120
    }
  ],
  "k03-04": [
    {
      "text": "그래서 파란빛은 빨간빛보다",
      "startMs": 0,
      "endMs": 2370
    },
    {
      "text": "다섯 배 넘게 잘 흩어져요.",
      "startMs": 2370,
      "endMs": 4100
    }
  ],
  "k03-05": [
    {
      "text": "이 현상을 처음 설명한",
      "startMs": 0,
      "endMs": 1310
    },
    {
      "text": "과학자의 이름을 따서,",
      "startMs": 1310,
      "endMs": 2640
    },
    {
      "text": "레일리 산란이라고 불러요.",
      "startMs": 2640,
      "endMs": 4840
    }
  ],
  "k04-01": [
    {
      "text": "이제 하늘을 올려다볼",
      "startMs": 0,
      "endMs": 1380
    },
    {
      "text": "때를 생각해 볼게요.",
      "startMs": 1380,
      "endMs": 2980
    }
  ],
  "k04-02": [
    {
      "text": "빨간빛은 대부분 공기를 곧장",
      "startMs": 0,
      "endMs": 2580
    },
    {
      "text": "통과해서 지나가 버려요.",
      "startMs": 2580,
      "endMs": 4460
    }
  ],
  "k04-03": [
    {
      "text": "반면 파란빛은 하늘",
      "startMs": 0,
      "endMs": 1650
    },
    {
      "text": "곳곳에서 이리저리 흩어지죠.",
      "startMs": 1650,
      "endMs": 3940
    }
  ],
  "k04-04": [
    {
      "text": "흩어진 파란빛이 하늘의 모든",
      "startMs": 0,
      "endMs": 2580
    },
    {
      "text": "방향에서 우리 눈으로 들어와요.",
      "startMs": 2580,
      "endMs": 4540
    }
  ],
  "k04-05": [
    {
      "text": "그래서 해가 없는 쪽을 봐도,",
      "startMs": 0,
      "endMs": 2150
    },
    {
      "text": "하늘 전체가 파랗게 보이는 거예요.",
      "startMs": 2150,
      "endMs": 4320
    }
  ],
  "k05-01": [
    {
      "text": "잠깐, 보랏빛은 파란빛보다",
      "startMs": 0,
      "endMs": 3660
    },
    {
      "text": "파장이 더 짧잖아요.",
      "startMs": 3660,
      "endMs": 4360
    }
  ],
  "k05-02": [
    {
      "text": "그럼 하늘은 보라색이어야",
      "startMs": 0,
      "endMs": 1850
    },
    {
      "text": "하지 않을까요?",
      "startMs": 1850,
      "endMs": 3020
    }
  ],
  "k05-03": [
    {
      "text": "첫째, 햇빛에는 원래 보랏빛이",
      "startMs": 0,
      "endMs": 2420
    },
    {
      "text": "파란빛보다 적게 들어 있어요.",
      "startMs": 2420,
      "endMs": 4720
    }
  ],
  "k05-04": [
    {
      "text": "둘째, 보랏빛의 일부는 대기 높은",
      "startMs": 0,
      "endMs": 2440
    },
    {
      "text": "곳에서 흡수돼 버려요.",
      "startMs": 2440,
      "endMs": 4320
    }
  ],
  "k05-05": [
    {
      "text": "셋째, 우리 눈은 보라색보다",
      "startMs": 0,
      "endMs": 2320
    },
    {
      "text": "파란색을 훨씬 잘 느껴요.",
      "startMs": 2320,
      "endMs": 4460
    }
  ],
  "k05-06": [
    {
      "text": "이 세 가지가 합쳐져서,",
      "startMs": 0,
      "endMs": 1860
    },
    {
      "text": "우리 눈에는 하늘이 파랗게 보여요.",
      "startMs": 1860,
      "endMs": 4100
    }
  ],
  "k06-01": [
    {
      "text": "이제 노을 이야기를 해 볼게요.",
      "startMs": 0,
      "endMs": 1980
    }
  ],
  "k06-02": [
    {
      "text": "한낮에는 해가 머리 위에 있어서,",
      "startMs": 0,
      "endMs": 1950
    },
    {
      "text": "햇빛이 짧은 거리의 공기만 지나와요.",
      "startMs": 1950,
      "endMs": 5540
    }
  ],
  "k06-03": [
    {
      "text": "하지만 해가 지평선 가까이 내려가면,",
      "startMs": 0,
      "endMs": 2990
    },
    {
      "text": "햇빛은 공기층을 비스듬히",
      "startMs": 2990,
      "endMs": 6080
    },
    {
      "text": "아주 길게 지나와야 해요.",
      "startMs": 6080,
      "endMs": 8120
    }
  ],
  "k06-04": [
    {
      "text": "그 거리는 한낮보다",
      "startMs": 0,
      "endMs": 1260
    },
    {
      "text": "수십 배나 길어요.",
      "startMs": 1260,
      "endMs": 3200
    }
  ],
  "k06-05": [
    {
      "text": "긴 길을 오는 동안 파란빛은",
      "startMs": 0,
      "endMs": 2490
    },
    {
      "text": "중간에 다 흩어져서 사라져 버려요.",
      "startMs": 2490,
      "endMs": 5420
    }
  ],
  "k06-06": [
    {
      "text": "끝까지 살아남아 우리",
      "startMs": 0,
      "endMs": 1520
    },
    {
      "text": "눈에 도착하는 건,",
      "startMs": 1520,
      "endMs": 2760
    },
    {
      "text": "잘 흩어지지 않는",
      "startMs": 2760,
      "endMs": 3810
    },
    {
      "text": "주황빛과 빨간빛이에요.",
      "startMs": 3810,
      "endMs": 6400
    }
  ],
  "k06-07": [
    {
      "text": "그래서 노을은 붉게 물드는 거예요.",
      "startMs": 0,
      "endMs": 2400
    }
  ],
  "k06-08": [
    {
      "text": "공기 중에 먼지나 작은",
      "startMs": 0,
      "endMs": 1400
    },
    {
      "text": "물방울이 많은 날에는,",
      "startMs": 1400,
      "endMs": 3630
    },
    {
      "text": "노을이 더 진하게 보이기도 해요.",
      "startMs": 3630,
      "endMs": 6140
    }
  ],
  "k07-01": [
    {
      "text": "그럼 구름은 왜 하얄까요?",
      "startMs": 0,
      "endMs": 1920
    }
  ],
  "k07-02": [
    {
      "text": "구름은 공기 분자보다 훨씬 큰",
      "startMs": 0,
      "endMs": 2710
    },
    {
      "text": "물방울과 얼음 알갱이로 되어 있어요.",
      "startMs": 2710,
      "endMs": 5560
    }
  ],
  "k07-03": [
    {
      "text": "알갱이가 크면 모든 색의 빛을",
      "startMs": 0,
      "endMs": 2040
    },
    {
      "text": "거의 똑같이 흩어 버려요.",
      "startMs": 2040,
      "endMs": 3900
    }
  ],
  "k07-04": [
    {
      "text": "모든 색이 골고루",
      "startMs": 0,
      "endMs": 1100
    },
    {
      "text": "섞이면 하얗게 보이죠.",
      "startMs": 1100,
      "endMs": 2580
    }
  ],
  "k07-05": [
    {
      "text": "먹구름이 어두운 건,",
      "startMs": 0,
      "endMs": 2020
    },
    {
      "text": "구름이 두꺼워서 햇빛이 아래까지",
      "startMs": 2020,
      "endMs": 4790
    },
    {
      "text": "잘 뚫고 오지 못하기 때문이에요.",
      "startMs": 4790,
      "endMs": 6480
    }
  ],
  "k08-01": [
    {
      "text": "다른 행성의 하늘은 어떨까요?",
      "startMs": 0,
      "endMs": 2140
    }
  ],
  "k08-02": [
    {
      "text": "화성은 공기가 아주 옅고,",
      "startMs": 0,
      "endMs": 2920
    },
    {
      "text": "대신 고운 먼지가 많이 떠 있어요.",
      "startMs": 2920,
      "endMs": 5540
    }
  ],
  "k08-03": [
    {
      "text": "그래서 화성의 낮 하늘은",
      "startMs": 0,
      "endMs": 1440
    },
    {
      "text": "누르스름한 빛을 띠어요.",
      "startMs": 1440,
      "endMs": 3620
    }
  ],
  "k08-04": [
    {
      "text": "놀랍게도 화성의 노을은",
      "startMs": 0,
      "endMs": 1540
    },
    {
      "text": "오히려 푸르스름하게 보여요.",
      "startMs": 1540,
      "endMs": 4140
    }
  ],
  "k08-05": [
    {
      "text": "하늘의 색은 그 행성의",
      "startMs": 0,
      "endMs": 1540
    },
    {
      "text": "공기와 먼지가 빛을",
      "startMs": 1540,
      "endMs": 2860
    },
    {
      "text": "어떻게 흩어 놓느냐에",
      "startMs": 2860,
      "endMs": 5290
    },
    {
      "text": "달려 있는 거예요.",
      "startMs": 5290,
      "endMs": 6360
    }
  ],
  "k09-01": [
    {
      "text": "이 원리는 집에서도",
      "startMs": 0,
      "endMs": 1490
    },
    {
      "text": "직접 확인할 수 있어요.",
      "startMs": 1490,
      "endMs": 3380
    }
  ],
  "k09-02": [
    {
      "text": "투명한 컵에 물을 담고,",
      "startMs": 0,
      "endMs": 2090
    },
    {
      "text": "우유를 몇 방울만",
      "startMs": 2090,
      "endMs": 3050
    },
    {
      "text": "떨어뜨려 저어 주세요.",
      "startMs": 3050,
      "endMs": 4440
    }
  ],
  "k09-03": [
    {
      "text": "어두운 방에서 컵 옆면에",
      "startMs": 0,
      "endMs": 1580
    },
    {
      "text": "손전등을 비춰 보세요.",
      "startMs": 1580,
      "endMs": 3620
    }
  ],
  "k09-04": [
    {
      "text": "옆에서 보면 물이 살짝",
      "startMs": 0,
      "endMs": 1430
    },
    {
      "text": "푸르스름하게 보여요.",
      "startMs": 1430,
      "endMs": 3700
    },
    {
      "text": "낮 하늘과 같아요.",
      "startMs": 3700,
      "endMs": 5340
    }
  ],
  "k09-05": [
    {
      "text": "반대편에서 손전등 쪽을 바라보면,",
      "startMs": 0,
      "endMs": 2930
    },
    {
      "text": "빛이 주황빛으로 보여요.",
      "startMs": 2930,
      "endMs": 5180
    },
    {
      "text": "노을과 같은 원리죠.",
      "startMs": 5180,
      "endMs": 6320
    }
  ],
  "k10-01": [
    {
      "text": "정리하면, 파란빛은 공기에 잘 흩어져서",
      "startMs": 0,
      "endMs": 3180
    },
    {
      "text": "하늘을 파랗게 칠하고,",
      "startMs": 3180,
      "endMs": 5040
    }
  ],
  "k10-02": [
    {
      "text": "해가 낮게 뜨면 파란빛은",
      "startMs": 0,
      "endMs": 2040
    },
    {
      "text": "흩어져 사라지고,",
      "startMs": 2040,
      "endMs": 3490
    },
    {
      "text": "남은 붉은빛이 노을을 만들어요.",
      "startMs": 3490,
      "endMs": 5740
    }
  ],
  "k10-03": [
    {
      "text": "오늘 저녁 노을을 보게 되면,",
      "startMs": 0,
      "endMs": 1440
    },
    {
      "text": "먼 길을 달려온 빛을 떠올려 보세요.",
      "startMs": 1440,
      "endMs": 4960
    }
  ],
  "k10-04": [
    {
      "text": "영상이 도움이 되었다면",
      "startMs": 0,
      "endMs": 1730
    },
    {
      "text": "구독과 좋아요 부탁드려요.",
      "startMs": 1730,
      "endMs": 3300
    },
    {
      "text": "다음 영상에서 만나요!",
      "startMs": 3300,
      "endMs": 5120
    }
  ]
}
