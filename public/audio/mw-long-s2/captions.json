{
  "m00-01": [
    {
      "text": "차가운 밥을 전자레인지에",
      "startMs": 0,
      "endMs": 1290
    },
    {
      "text": "넣고 버튼을 누르면,",
      "startMs": 1290,
      "endMs": 2430
    },
    {
      "text": "1분 만에 김이 모락모락 나죠.",
      "startMs": 2430,
      "endMs": 5760
    }
  ],
  "m00-02": [
    {
      "text": "그런데 전자레인지 안에는 불도 없고,",
      "startMs": 0,
      "endMs": 2730
    },
    {
      "text": "뜨겁게 달궈진 열선도 없어요.",
      "startMs": 2730,
      "endMs": 5060
    }
  ],
  "m00-03": [
    {
      "text": "게다가 음식은 뜨거운데,",
      "startMs": 0,
      "endMs": 1370
    },
    {
      "text": "전자레인지 안쪽 벽은",
      "startMs": 1370,
      "endMs": 3230
    },
    {
      "text": "별로 뜨겁지 않아요.",
      "startMs": 3230,
      "endMs": 4700
    }
  ],
  "m00-04": [
    {
      "text": "전자레인지는 음식을",
      "startMs": 0,
      "endMs": 1620
    },
    {
      "text": "바깥에서 달구지 않아요.",
      "startMs": 1620,
      "endMs": 3640
    }
  ],
  "m00-05": [
    {
      "text": "눈에 보이지 않는 파동으로,",
      "startMs": 0,
      "endMs": 1430
    },
    {
      "text": "음식 속의 물을 직접",
      "startMs": 1430,
      "endMs": 2760
    },
    {
      "text": "흔들어서 데워요.",
      "startMs": 2760,
      "endMs": 4220
    }
  ],
  "m00-06": [
    {
      "text": "오늘은 그 원리를 하나씩,",
      "startMs": 0,
      "endMs": 1980
    },
    {
      "text": "천천히 알아보겠습니다.",
      "startMs": 1980,
      "endMs": 3960
    }
  ],
  "m01-01": [
    {
      "text": "먼저 열이 무엇인지부터 알아볼게요.",
      "startMs": 0,
      "endMs": 2940
    }
  ],
  "m01-02": [
    {
      "text": "모든 물질은 눈에 보이지",
      "startMs": 0,
      "endMs": 2040
    },
    {
      "text": "않는 아주 작은 알갱이,",
      "startMs": 2040,
      "endMs": 3940
    },
    {
      "text": "분자로 이루어져 있어요.",
      "startMs": 3940,
      "endMs": 6120
    }
  ],
  "m01-03": [
    {
      "text": "분자들은 가만히 있지",
      "startMs": 0,
      "endMs": 1470
    },
    {
      "text": "않고 끊임없이 움직여요.",
      "startMs": 1470,
      "endMs": 3120
    }
  ],
  "m01-04": [
    {
      "text": "분자가 빠르게",
      "startMs": 0,
      "endMs": 1140
    },
    {
      "text": "움직일수록 온도가 높고,",
      "startMs": 1140,
      "endMs": 2890
    },
    {
      "text": "느리게 움직일수록 온도가 낮아요.",
      "startMs": 2890,
      "endMs": 5400
    }
  ],
  "m01-05": [
    {
      "text": "그러니까 음식을 데운다는 건,",
      "startMs": 0,
      "endMs": 2550
    },
    {
      "text": "음식 속 분자들을 더 빠르게",
      "startMs": 2550,
      "endMs": 4900
    },
    {
      "text": "움직이게 만든다는 뜻이에요.",
      "startMs": 4900,
      "endMs": 6720
    }
  ],
  "m02-01": [
    {
      "text": "가스레인지는 불로 냄비를 달구고,",
      "startMs": 0,
      "endMs": 3160
    },
    {
      "text": "그 열이 바깥에서",
      "startMs": 3160,
      "endMs": 4350
    },
    {
      "text": "안으로 천천히 전해져요.",
      "startMs": 4350,
      "endMs": 6380
    }
  ],
  "m02-02": [
    {
      "text": "전자레인지는 전혀 다른 방법을 써요.",
      "startMs": 0,
      "endMs": 2830
    },
    {
      "text": "바로 마이크로파예요.",
      "startMs": 2830,
      "endMs": 4840
    }
  ],
  "m02-03": [
    {
      "text": "마이크로파는 빛과 같은 종류의 파동,",
      "startMs": 0,
      "endMs": 3260
    },
    {
      "text": "전자기파예요.",
      "startMs": 3260,
      "endMs": 4000
    }
  ],
  "m02-04": [
    {
      "text": "다만 눈에 보이는 빛보다",
      "startMs": 0,
      "endMs": 2000
    },
    {
      "text": "파장이 훨씬 길어서,",
      "startMs": 2000,
      "endMs": 3480
    },
    {
      "text": "우리 눈에는 보이지 않아요.",
      "startMs": 3480,
      "endMs": 5080
    }
  ],
  "m02-05": [
    {
      "text": "전자레인지가 쓰는 마이크로파의",
      "startMs": 0,
      "endMs": 2070
    },
    {
      "text": "파장은 약 12센티미터예요.",
      "startMs": 2070,
      "endMs": 4300
    }
  ],
  "m02-06": [
    {
      "text": "와이파이 신호도 이와",
      "startMs": 0,
      "endMs": 1380
    },
    {
      "text": "비슷한 파동이에요.",
      "startMs": 1380,
      "endMs": 2900
    }
  ],
  "m02-07": [
    {
      "text": "전자레인지 안에는",
      "startMs": 0,
      "endMs": 980
    },
    {
      "text": "마그네트론이라는 부품이 있어서,",
      "startMs": 980,
      "endMs": 3090
    },
    {
      "text": "이 마이크로파를 만들어 내요.",
      "startMs": 3090,
      "endMs": 5460
    }
  ],
  "m03-01": [
    {
      "text": "그럼 마이크로파는",
      "startMs": 0,
      "endMs": 1510
    },
    {
      "text": "어떻게 음식을 데울까요?",
      "startMs": 1510,
      "endMs": 3030
    },
    {
      "text": "비밀은 물 분자에 있어요.",
      "startMs": 3030,
      "endMs": 5780
    }
  ],
  "m03-02": [
    {
      "text": "물 분자는 한쪽은 플러스,",
      "startMs": 0,
      "endMs": 1970
    },
    {
      "text": "반대쪽은 마이너스 전기를",
      "startMs": 1970,
      "endMs": 4470
    },
    {
      "text": "살짝 띠고 있어요.",
      "startMs": 4470,
      "endMs": 5580
    }
  ],
  "m03-03": [
    {
      "text": "나침반 바늘이 자석을 따라 돌듯이,",
      "startMs": 0,
      "endMs": 2790
    },
    {
      "text": "물 분자도 전기의",
      "startMs": 2790,
      "endMs": 3980
    },
    {
      "text": "방향을 따라 돌아요.",
      "startMs": 3980,
      "endMs": 5320
    }
  ],
  "m03-04": [
    {
      "text": "그런데 마이크로파 속에서는 전기의",
      "startMs": 0,
      "endMs": 2440
    },
    {
      "text": "방향이 1초에 수십억 번씩 뒤집혀요.",
      "startMs": 2440,
      "endMs": 5060
    }
  ],
  "m03-05": [
    {
      "text": "물 분자는 그 방향을 따라가려고",
      "startMs": 0,
      "endMs": 1800
    },
    {
      "text": "이리저리 몸을 돌려요.",
      "startMs": 1800,
      "endMs": 4060
    }
  ],
  "m03-06": [
    {
      "text": "이렇게 흔들리는 물 분자들이 주변",
      "startMs": 0,
      "endMs": 2370
    },
    {
      "text": "분자들과 부딪히고 비벼지면서,",
      "startMs": 2370,
      "endMs": 5000
    },
    {
      "text": "움직임이 열로 바뀌어요.",
      "startMs": 5000,
      "endMs": 6880
    }
  ],
  "m03-07": [
    {
      "text": "추운 날 손을 비비면",
      "startMs": 0,
      "endMs": 1270
    },
    {
      "text": "따뜻해지는 것과 비슷해요.",
      "startMs": 1270,
      "endMs": 2960
    }
  ],
  "m03-08": [
    {
      "text": "그래서 물기가 많은 음식일수록",
      "startMs": 0,
      "endMs": 2280
    },
    {
      "text": "전자레인지에서 잘 데워져요.",
      "startMs": 2280,
      "endMs": 4640
    }
  ],
  "m04-01": [
    {
      "text": "그럼 그릇은 어떨까요?",
      "startMs": 0,
      "endMs": 2020
    }
  ],
  "m04-02": [
    {
      "text": "유리나 도자기에는 마이크로파에",
      "startMs": 0,
      "endMs": 2340
    },
    {
      "text": "흔들릴 물 분자가 거의 없어요.",
      "startMs": 2340,
      "endMs": 5000
    }
  ],
  "m04-03": [
    {
      "text": "그래서 마이크로파는 그릇을",
      "startMs": 0,
      "endMs": 1900
    },
    {
      "text": "그냥 통과해 버려요.",
      "startMs": 1900,
      "endMs": 3200
    }
  ],
  "m04-04": [
    {
      "text": "그릇이 뜨거워졌다면,",
      "startMs": 0,
      "endMs": 1960
    },
    {
      "text": "그건 뜨거워진 음식의 열이",
      "startMs": 1960,
      "endMs": 3500
    },
    {
      "text": "그릇으로 옮겨 갔기 때문이에요.",
      "startMs": 3500,
      "endMs": 5560
    }
  ],
  "m04-05": [
    {
      "text": "전자레인지 안의 공기와 벽이 별로",
      "startMs": 0,
      "endMs": 2180
    },
    {
      "text": "뜨겁지 않은 것도 같은 이유예요.",
      "startMs": 2180,
      "endMs": 4340
    }
  ],
  "m04-06": [
    {
      "text": "꽁꽁 언 얼음도 잘 데워지지 않아요.",
      "startMs": 0,
      "endMs": 3220
    },
    {
      "text": "얼음 속 물 분자는 단단히 붙잡혀",
      "startMs": 3220,
      "endMs": 5680
    },
    {
      "text": "있어서 잘 돌지 못하거든요.",
      "startMs": 5680,
      "endMs": 7640
    }
  ],
  "m04-07": [
    {
      "text": "그래서 해동할 때는,",
      "startMs": 0,
      "endMs": 1700
    },
    {
      "text": "먼저 녹은 곳만 뜨거워지고",
      "startMs": 1700,
      "endMs": 3130
    },
    {
      "text": "속은 아직 얼어 있기도 해요.",
      "startMs": 3130,
      "endMs": 5460
    }
  ],
  "m05-01": [
    {
      "text": "전자레인지는 음식을",
      "startMs": 0,
      "endMs": 1420
    },
    {
      "text": "속부터 익힌다는 말,",
      "startMs": 1420,
      "endMs": 2760
    },
    {
      "text": "들어 본 적 있나요?",
      "startMs": 2760,
      "endMs": 4260
    }
  ],
  "m05-02": [
    {
      "text": "사실은 그렇지 않아요.",
      "startMs": 0,
      "endMs": 1420
    }
  ],
  "m05-03": [
    {
      "text": "마이크로파는 음식 겉에서 1에서",
      "startMs": 0,
      "endMs": 2870
    },
    {
      "text": "2센티미터 정도까지만 파고들어요.",
      "startMs": 2870,
      "endMs": 5340
    }
  ],
  "m05-04": [
    {
      "text": "그보다 깊은 속은,",
      "startMs": 0,
      "endMs": 1740
    },
    {
      "text": "바깥쪽에서 생긴 열이",
      "startMs": 1740,
      "endMs": 2980
    },
    {
      "text": "천천히 전해져서 데워져요.",
      "startMs": 2980,
      "endMs": 5060
    }
  ],
  "m05-05": [
    {
      "text": "다만 불로 구울 때는",
      "startMs": 0,
      "endMs": 1930
    },
    {
      "text": "겉 표면만 뜨거워지는데,",
      "startMs": 1930,
      "endMs": 3910
    },
    {
      "text": "전자레인지는 조금",
      "startMs": 3910,
      "endMs": 5270
    },
    {
      "text": "안쪽까지 한꺼번에 데워요.",
      "startMs": 5270,
      "endMs": 6840
    }
  ],
  "m05-06": [
    {
      "text": "그래서 훨씬 빨리 데워지고,",
      "startMs": 0,
      "endMs": 2170
    },
    {
      "text": "속부터 익는 것처럼 느껴지는 거예요.",
      "startMs": 2170,
      "endMs": 4100
    }
  ],
  "m05-07": [
    {
      "text": "두꺼운 음식을 데웠는데 가운데만",
      "startMs": 0,
      "endMs": 2640
    },
    {
      "text": "차가운 이유가 바로 이거예요.",
      "startMs": 2640,
      "endMs": 4400
    }
  ],
  "m06-01": [
    {
      "text": "전자레인지 속 접시는",
      "startMs": 0,
      "endMs": 1530
    },
    {
      "text": "왜 빙글빙글 돌까요?",
      "startMs": 1530,
      "endMs": 3860
    }
  ],
  "m06-02": [
    {
      "text": "마이크로파는 금속으로 된 안쪽",
      "startMs": 0,
      "endMs": 2120
    },
    {
      "text": "벽에 부딪혀 계속 반사돼요.",
      "startMs": 2120,
      "endMs": 5000
    }
  ],
  "m06-03": [
    {
      "text": "이리저리 반사된 파동들이 겹치면,",
      "startMs": 0,
      "endMs": 3500
    },
    {
      "text": "세게 흔들리는 곳과 거의",
      "startMs": 3500,
      "endMs": 5220
    },
    {
      "text": "흔들리지 않는 곳이 생겨요.",
      "startMs": 5220,
      "endMs": 6420
    }
  ],
  "m06-04": [
    {
      "text": "세게 흔들리는 곳에서는",
      "startMs": 0,
      "endMs": 1880
    },
    {
      "text": "음식이 뜨거워지고,",
      "startMs": 1880,
      "endMs": 3480
    },
    {
      "text": "그렇지 않은 곳에서는 차갑게 남아요.",
      "startMs": 3480,
      "endMs": 5980
    }
  ],
  "m06-05": [
    {
      "text": "뜨거운 곳과 뜨거운 곳",
      "startMs": 0,
      "endMs": 1330
    },
    {
      "text": "사이의 간격은 파장의 절반,",
      "startMs": 1330,
      "endMs": 3410
    },
    {
      "text": "약 6센티미터예요.",
      "startMs": 3410,
      "endMs": 5760
    }
  ],
  "m06-06": [
    {
      "text": "그래서 접시를 돌려서,",
      "startMs": 0,
      "endMs": 2410
    },
    {
      "text": "음식이 뜨거운 곳을 골고루",
      "startMs": 2410,
      "endMs": 4050
    },
    {
      "text": "지나가게 하는 거예요.",
      "startMs": 4050,
      "endMs": 5600
    }
  ],
  "m07-01": [
    {
      "text": "전자레인지 문을 자세히 보면,",
      "startMs": 0,
      "endMs": 1920
    },
    {
      "text": "작은 구멍이 촘촘히 뚫린",
      "startMs": 1920,
      "endMs": 4130
    },
    {
      "text": "금속판이 붙어 있어요.",
      "startMs": 4130,
      "endMs": 5520
    }
  ],
  "m07-02": [
    {
      "text": "마이크로파는 파장이",
      "startMs": 0,
      "endMs": 1340
    },
    {
      "text": "12센티미터나 돼서,",
      "startMs": 1340,
      "endMs": 3010
    },
    {
      "text": "이 작은 구멍을 빠져나가지 못해요.",
      "startMs": 3010,
      "endMs": 4880
    }
  ],
  "m07-03": [
    {
      "text": "반면 눈에 보이는 빛은 파장이",
      "startMs": 0,
      "endMs": 2200
    },
    {
      "text": "아주 짧아서 구멍을 쉽게 통과해요.",
      "startMs": 2200,
      "endMs": 4620
    }
  ],
  "m07-04": [
    {
      "text": "그래서 마이크로파는 안에 가두면서도,",
      "startMs": 0,
      "endMs": 2580
    },
    {
      "text": "우리는 안을 들여다볼",
      "startMs": 2580,
      "endMs": 3720
    },
    {
      "text": "수 있는 거예요.",
      "startMs": 3720,
      "endMs": 4560
    }
  ],
  "m07-05": [
    {
      "text": "그럼 금속 그릇을",
      "startMs": 0,
      "endMs": 1130
    },
    {
      "text": "넣으면 어떻게 될까요?",
      "startMs": 1130,
      "endMs": 2660
    }
  ],
  "m07-06": [
    {
      "text": "금속은 마이크로파를 반사해서,",
      "startMs": 0,
      "endMs": 2730
    },
    {
      "text": "속의 음식이 잘 데워지지 않아요.",
      "startMs": 2730,
      "endMs": 4420
    }
  ],
  "m07-07": [
    {
      "text": "게다가 포크나 구겨진 포일처럼 뾰족한",
      "startMs": 0,
      "endMs": 2710
    },
    {
      "text": "금속에는 전기가 몰려서",
      "startMs": 2710,
      "endMs": 4590
    },
    {
      "text": "불꽃이 튈 수 있어요.",
      "startMs": 4590,
      "endMs": 6160
    }
  ],
  "m08-01": [
    {
      "text": "이 원리를 이용하면,",
      "startMs": 0,
      "endMs": 1130
    },
    {
      "text": "집에서 빛의 속도를 잴 수 있어요.",
      "startMs": 1130,
      "endMs": 3920
    }
  ],
  "m08-02": [
    {
      "text": "회전 접시와 받침 바퀴를 빼고,",
      "startMs": 0,
      "endMs": 2670
    },
    {
      "text": "평평한 접시에 판",
      "startMs": 2670,
      "endMs": 3570
    },
    {
      "text": "초콜릿을 올려 주세요.",
      "startMs": 3570,
      "endMs": 5200
    }
  ],
  "m08-03": [
    {
      "text": "20초쯤 돌린 뒤 꺼내 보면,",
      "startMs": 0,
      "endMs": 2310
    },
    {
      "text": "초콜릿이 군데군데만 녹아 있어요.",
      "startMs": 2310,
      "endMs": 5720
    }
  ],
  "m08-04": [
    {
      "text": "녹은 곳과 녹은 곳 사이의",
      "startMs": 0,
      "endMs": 1270
    },
    {
      "text": "거리를 자로 재 보세요.",
      "startMs": 1270,
      "endMs": 2940
    },
    {
      "text": "약 6센티미터가 나와요.",
      "startMs": 2940,
      "endMs": 6600
    }
  ],
  "m08-05": [
    {
      "text": "이 거리의 두 배가",
      "startMs": 0,
      "endMs": 1380
    },
    {
      "text": "마이크로파의 파장,",
      "startMs": 1380,
      "endMs": 3010
    },
    {
      "text": "12센티미터예요.",
      "startMs": 3010,
      "endMs": 4880
    }
  ],
  "m08-06": [
    {
      "text": "여기에 전자레인지",
      "startMs": 0,
      "endMs": 1450
    },
    {
      "text": "뒷면에 적힌 진동수,",
      "startMs": 1450,
      "endMs": 4000
    },
    {
      "text": "2450메가헤르츠를 곱해요.",
      "startMs": 4000,
      "endMs": 6460
    }
  ],
  "m08-07": [
    {
      "text": "그러면 1초에 약 30만 킬로미터,",
      "startMs": 0,
      "endMs": 3620
    },
    {
      "text": "바로 빛의 속도가 나와요.",
      "startMs": 3620,
      "endMs": 5420
    }
  ],
  "m08-08": [
    {
      "text": "부엌에서 초콜릿으로",
      "startMs": 0,
      "endMs": 1870
    },
    {
      "text": "빛의 속도를 잰 거예요.",
      "startMs": 1870,
      "endMs": 3460
    }
  ],
  "m09-01": [
    {
      "text": "마지막으로,",
      "startMs": 0,
      "endMs": 600
    },
    {
      "text": "원리를 알면 전자레인지를",
      "startMs": 600,
      "endMs": 2770
    },
    {
      "text": "더 똑똑하게 쓸 수 있어요.",
      "startMs": 2770,
      "endMs": 4620
    }
  ],
  "m09-02": [
    {
      "text": "첫째, 음식은 가운데를 비우고",
      "startMs": 0,
      "endMs": 2770
    },
    {
      "text": "도넛 모양으로 담아 주세요.",
      "startMs": 2770,
      "endMs": 4530
    },
    {
      "text": "마이크로파가 닿는 겉면이",
      "startMs": 4530,
      "endMs": 6610
    },
    {
      "text": "넓어져서 고르게 데워져요.",
      "startMs": 6610,
      "endMs": 8620
    }
  ],
  "m09-03": [
    {
      "text": "둘째, 데우는 중간에 한 번",
      "startMs": 0,
      "endMs": 2540
    },
    {
      "text": "꺼내서 저어 주세요.",
      "startMs": 2540,
      "endMs": 4490
    },
    {
      "text": "뜨거운 곳과 차가운 곳이 섞여요.",
      "startMs": 4490,
      "endMs": 6400
    }
  ],
  "m09-04": [
    {
      "text": "셋째, 뚜껑을 살짝 걸쳐서 덮어 주세요.",
      "startMs": 0,
      "endMs": 3920
    },
    {
      "text": "수분이 날아가지 않아서",
      "startMs": 3920,
      "endMs": 5320
    },
    {
      "text": "음식이 촉촉해요.",
      "startMs": 5320,
      "endMs": 6360
    }
  ],
  "m09-05": [
    {
      "text": "넷째, 껍질째 달걀이나 꽉 닫은",
      "startMs": 0,
      "endMs": 3880
    },
    {
      "text": "용기는 넣지 마세요.",
      "startMs": 3880,
      "endMs": 5150
    },
    {
      "text": "속에서 생긴 수증기가 빠져나가지",
      "startMs": 5150,
      "endMs": 8190
    },
    {
      "text": "못해 터질 수 있어요.",
      "startMs": 8000,
      "endMs": 8200
    }
  ],
  "m09-06": [
    {
      "text": "금속 그릇과 포일도",
      "startMs": 0,
      "endMs": 1580
    },
    {
      "text": "넣지 않는 게 안전해요.",
      "startMs": 1580,
      "endMs": 2860
    }
  ],
  "m10-01": [
    {
      "text": "오늘 내용을 한 문장으로 정리하면,",
      "startMs": 0,
      "endMs": 2400
    },
    {
      "text": "전자레인지는 마이크로파로 음식 속",
      "startMs": 2400,
      "endMs": 5740
    },
    {
      "text": "물 분자를 흔들어서 데우는 기계예요.",
      "startMs": 5740,
      "endMs": 8120
    }
  ],
  "m10-02": [
    {
      "text": "다음에 전자레인지를 돌릴 때,",
      "startMs": 0,
      "endMs": 2460
    },
    {
      "text": "접시 위에서 열심히 춤추고 있는",
      "startMs": 2460,
      "endMs": 4090
    },
    {
      "text": "물 분자들을 떠올려 보세요.",
      "startMs": 4090,
      "endMs": 6200
    }
  ],
  "m10-03": [
    {
      "text": "영상이 도움이 되었다면",
      "startMs": 0,
      "endMs": 1820
    },
    {
      "text": "구독과 좋아요 부탁드려요.",
      "startMs": 1820,
      "endMs": 3480
    },
    {
      "text": "다음 영상에서 만나요!",
      "startMs": 3480,
      "endMs": 5280
    }
  ]
}
