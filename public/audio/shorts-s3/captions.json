{
  "s1-01": [
    {
      "text": "에어컨 바람은 왜 차가울까요?",
      "startMs": 0,
      "endMs": 1920
    }
  ],
  "s1-02": [
    {
      "text": "사실 에어컨은 냉기를 만들지 않아요.",
      "startMs": 0,
      "endMs": 2700
    }
  ],
  "s1-03": [
    {
      "text": "방 안의 열을 바깥으로",
      "startMs": 0,
      "endMs": 1030
    },
    {
      "text": "옮기는 기계예요.",
      "startMs": 1030,
      "endMs": 2420
    }
  ],
  "s2-01": [
    {
      "text": "그런데 열은 뜨거운 곳에서",
      "startMs": 0,
      "endMs": 1550
    },
    {
      "text": "차가운 곳으로만 흘러요.",
      "startMs": 1550,
      "endMs": 3760
    }
  ],
  "s2-02": [
    {
      "text": "여름엔 바깥이 더 뜨거운데,",
      "startMs": 0,
      "endMs": 2160
    },
    {
      "text": "어떻게 열을 내보낼까요?",
      "startMs": 2160,
      "endMs": 4460
    }
  ],
  "s2-03": [
    {
      "text": "비밀은 바로 냉매예요.",
      "startMs": 0,
      "endMs": 1900
    }
  ],
  "s3-01": [
    {
      "text": "실내기에서는 5도의 차가운",
      "startMs": 0,
      "endMs": 1910
    },
    {
      "text": "냉매가 방의 열을 흡수해요.",
      "startMs": 1910,
      "endMs": 4460
    }
  ],
  "s3-02": [
    {
      "text": "압축기가 냉매를 꾹 눌러서",
      "startMs": 0,
      "endMs": 2800
    },
    {
      "text": "70도로 뜨겁게 만들고,",
      "startMs": 2800,
      "endMs": 3980
    }
  ],
  "s3-03": [
    {
      "text": "실외기에서 그 열을 바깥에 버려요.",
      "startMs": 0,
      "endMs": 2040
    }
  ],
  "s3-04": [
    {
      "text": "팽창밸브를 지나면 냉매는",
      "startMs": 0,
      "endMs": 2020
    },
    {
      "text": "다시 차갑게 식어요.",
      "startMs": 2020,
      "endMs": 3060
    }
  ],
  "s4-01": [
    {
      "text": "이 순환을 쉬지 않고 반복하는 것,",
      "startMs": 0,
      "endMs": 2400
    },
    {
      "text": "그게 에어컨의 원리예요.",
      "startMs": 2400,
      "endMs": 3820
    }
  ],
  "s4-02": [
    {
      "text": "더 자세한 이야기는 롱폼",
      "startMs": 0,
      "endMs": 1430
    },
    {
      "text": "영상에서 확인해 보세요!",
      "startMs": 1430,
      "endMs": 2980
    }
  ]
}
