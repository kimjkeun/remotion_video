{
  "q1-01": [
    {
      "text": "하늘은 왜 파랗고,",
      "startMs": 0,
      "endMs": 2120
    },
    {
      "text": "노을은 왜 빨갈까요?",
      "startMs": 2120,
      "endMs": 3800
    }
  ],
  "q1-02": [
    {
      "text": "햇빛에는 여러 색의",
      "startMs": 0,
      "endMs": 1840
    },
    {
      "text": "빛이 섞여 있어요.",
      "startMs": 1840,
      "endMs": 3100
    }
  ],
  "q1-03": [
    {
      "text": "이 빛이 공기를 만나면",
      "startMs": 0,
      "endMs": 1800
    },
    {
      "text": "사방으로 흩어지는데,",
      "startMs": 1800,
      "endMs": 3800
    }
  ],
  "q2-01": [
    {
      "text": "파장이 짧은 파란빛이 빨간빛보다",
      "startMs": 0,
      "endMs": 3260
    },
    {
      "text": "다섯 배 넘게 잘 흩어져요.",
      "startMs": 3260,
      "endMs": 5200
    }
  ],
  "q2-02": [
    {
      "text": "흩어진 파란빛이 하늘",
      "startMs": 0,
      "endMs": 2090
    },
    {
      "text": "곳곳에서 눈으로 들어와서,",
      "startMs": 2090,
      "endMs": 4000
    },
    {
      "text": "하늘이 파랗게 보여요.",
      "startMs": 4000,
      "endMs": 5240
    }
  ],
  "q3-01": [
    {
      "text": "그런데 해가 지면,",
      "startMs": 0,
      "endMs": 1410
    },
    {
      "text": "햇빛이 지나야 할 공기",
      "startMs": 1410,
      "endMs": 3670
    },
    {
      "text": "길이가 수십 배로 길어져요.",
      "startMs": 3670,
      "endMs": 6120
    }
  ],
  "q3-02": [
    {
      "text": "파란빛은 오는 길에",
      "startMs": 0,
      "endMs": 1440
    },
    {
      "text": "다 흩어져 사라지고,",
      "startMs": 1440,
      "endMs": 3180
    }
  ],
  "q3-03": [
    {
      "text": "끝까지 남은 주황빛과",
      "startMs": 0,
      "endMs": 1650
    },
    {
      "text": "빨간빛이 노을을 만들어요.",
      "startMs": 1650,
      "endMs": 3820
    }
  ],
  "q4-01": [
    {
      "text": "같은 햇빛,",
      "startMs": 0,
      "endMs": 1340
    },
    {
      "text": "다른 길이.",
      "startMs": 1340,
      "endMs": 2570
    },
    {
      "text": "그게 하늘 색의 비밀이에요.",
      "startMs": 2570,
      "endMs": 4300
    }
  ],
  "q4-02": [
    {
      "text": "더 자세한 이야기는 롱폼",
      "startMs": 0,
      "endMs": 1670
    },
    {
      "text": "영상에서 확인해 보세요!",
      "startMs": 1670,
      "endMs": 3560
    }
  ]
}
