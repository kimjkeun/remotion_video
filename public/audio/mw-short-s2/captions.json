{
  "w1-01": [
    {
      "text": "전자레인지는 불도 없이",
      "startMs": 0,
      "endMs": 2000
    },
    {
      "text": "어떻게 음식을 데울까요?",
      "startMs": 2000,
      "endMs": 4300
    }
  ],
  "w1-02": [
    {
      "text": "비밀은 눈에 보이지 않는 파동,",
      "startMs": 0,
      "endMs": 2820
    },
    {
      "text": "마이크로파예요.",
      "startMs": 2820,
      "endMs": 3860
    }
  ],
  "w1-03": [
    {
      "text": "마이크로파는 음식 속 물 분자를",
      "startMs": 0,
      "endMs": 2650
    },
    {
      "text": "1초에 수십억 번 흔들어요.",
      "startMs": 2650,
      "endMs": 5100
    }
  ],
  "w2-01": [
    {
      "text": "흔들린 물 분자들이 서로",
      "startMs": 0,
      "endMs": 2550
    },
    {
      "text": "부딪히고 비벼지면서 열이 생겨요.",
      "startMs": 2550,
      "endMs": 4680
    }
  ],
  "w2-02": [
    {
      "text": "그래서 물이 없는 그릇은 그대로인데,",
      "startMs": 0,
      "endMs": 3090
    },
    {
      "text": "음식만 뜨거워지는 거예요.",
      "startMs": 3090,
      "endMs": 5600
    }
  ],
  "w3-01": [
    {
      "text": "그런데 속부터 익는다는",
      "startMs": 0,
      "endMs": 3170
    },
    {
      "text": "말은 오해예요.",
      "startMs": 3170,
      "endMs": 3480
    }
  ],
  "w3-02": [
    {
      "text": "마이크로파는 겉에서 1에서",
      "startMs": 0,
      "endMs": 2300
    },
    {
      "text": "2센티미터까지만 파고들어요.",
      "startMs": 2300,
      "endMs": 4400
    }
  ],
  "w3-03": [
    {
      "text": "두꺼운 음식의 가운데가",
      "startMs": 0,
      "endMs": 1750
    },
    {
      "text": "차가운 이유죠.",
      "startMs": 1750,
      "endMs": 2620
    }
  ],
  "w4-01": [
    {
      "text": "불 대신 물 분자를 흔드는 것,",
      "startMs": 0,
      "endMs": 2820
    },
    {
      "text": "그게 전자레인지의 원리예요.",
      "startMs": 2820,
      "endMs": 4620
    }
  ],
  "w4-02": [
    {
      "text": "더 자세한 이야기는 롱폼",
      "startMs": 0,
      "endMs": 1580
    },
    {
      "text": "영상에서 확인해 보세요!",
      "startMs": 1580,
      "endMs": 3400
    }
  ]
}
